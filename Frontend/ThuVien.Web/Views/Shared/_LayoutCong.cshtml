@inject IOptions<ThuVienOptions> Opt
@{
    var tt = Opt.Value.ThongTin;
    var laBanDoc = User.Identity?.IsAuthenticated == true && User.HasClaim(ThuVienClaims.Loai, LoaiTaiKhoan.BanDoc);
    var duongDan = Context.Request.Path.Value ?? "/";
    var laTrangChu = duongDan == "/";
    // Giờ mở cửa hôm nay (khóa T2…T7, CN – ThuVien:ThongTin:GioMoCua); không cấu hình thì không hiển thị
    var thu = DateTime.Now.DayOfWeek switch
    {
        DayOfWeek.Monday => "T2", DayOfWeek.Tuesday => "T3", DayOfWeek.Wednesday => "T4", DayOfWeek.Thursday => "T5",
        DayOfWeek.Friday => "T6", DayOfWeek.Saturday => "T7", _ => "CN"
    };
    var gioHomNay = tt.GioMoCua.TryGetValue(thu, out var g) ? g : null;
    // Vùng điều hướng (file 04 mục 1): các khu của trang chủ; trang con cuộn về đúng khu qua neo
    var menu = new (string Ten, string Href, string Icon)[]
    {
        ("Trang chủ", "/", "bi-house"),
        ("Khám phá sách", "/#kham-pha", "bi-search"),
        ("Danh mục", "/#danh-muc", "bi-grid"),
        ("Kệ sách nổi bật", "/#ke-sach", "bi-bookshelf"),
        ("Hướng dẫn mượn sách", "/#huong-dan", "bi-signpost"),
        ("Thông tin thư viện", "/#thong-tin", "bi-info-circle"),
    };
    // Menu thả xuống “Hướng dẫn mượn sách” – các mục của trang /huong-dan
    var huongDan = new (string Ten, string Href, string Icon)[]
    {
        ("Mượn sách", "/huong-dan#muon", "bi-journal-arrow-up"),
        ("Đặt chỗ trên cổng", "/huong-dan#dat-cho", "bi-bookmark-check"),
        ("Gia hạn", "/huong-dan#gia-han", "bi-calendar-plus"),
        ("Trả sách", "/huong-dan#tra", "bi-journal-arrow-down"),
        ("Xử lý vi phạm", "/huong-dan#vi-pham", "bi-exclamation-octagon"),
        ("Tài khoản bạn đọc", "/huong-dan#tai-khoan", "bi-person-circle"),
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_HeadChung" />
    <title>@(ViewData["Title"] is string t ? t + " – " : "")@tt.TenThuVien</title>
    <link rel="stylesheet" href="/lib/lenis/1.3.27/lenis.css" />
    <link rel="stylesheet" href="/css/tokens-cong.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/cong.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/cong-dieu-huong.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/book-preview.css" asp-append-version="true" />
    @await RenderSectionAsync("Css", required: false)
</head>
<body class="cong" data-ban-doc="@(laBanDoc ? "1" : "0")" data-mo-sach-khi-tai="@(ViewData["MoSach"] as string)">
    <a class="bo-qua-noi-dung" href="#noiDung">Bỏ qua, tới nội dung chính</a>

    <header class="cong-header">
        <div class="cong-container cong-header__tien-ich">
            <button type="button" class="cong-lien-ket cong-header__menu d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#congMenu" aria-controls="congMenu" aria-label="Mở menu">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <a class="cong-logo" href="/" aria-label="@tt.TenThuVien – Trang chủ">
                <span class="cong-logo__dau" aria-hidden="true"><i class="bi bi-book-half"></i></span>
                <span class="cong-logo__ten">@tt.TenThuVien</span>
            </a>
            @if (gioHomNay is not null)
            {
                <span class="cong-header__gio d-none d-md-inline-flex"><i class="bi bi-clock" aria-hidden="true"></i>Hôm nay mở cửa: <strong>@gioHomNay</strong></span>
            }
            <div class="cong-header__phai">
                <a class="cong-lien-ket" id="lnkTimKiem" href="/kham-pha" aria-label="Tìm kiếm sách" aria-current="@(duongDan == "/kham-pha" ? "page" : null)">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </a>
                @if (laBanDoc)
                {
                    <a class="cong-lien-ket cong-chuong__nut" id="lnkYeuThich" href="/tai-khoan/yeu-thich" aria-label="Sách yêu thích">
                        <i class="bi bi-heart" aria-hidden="true"></i><span class="cong-chuong__so" id="soYeuThich" hidden></span>
                    </a>
                    @* Chuông thông báo: số chưa đọc + 10 thông báo mới nhất (file 07 mục 4) *@
                    <div class="dropdown cong-chuong">
                        <button type="button" class="cong-lien-ket cong-chuong__nut" id="btnChuongCong" data-bs-toggle="dropdown"
                                data-bs-auto-close="outside" aria-expanded="false" aria-label="Thông báo">
                            <i class="bi bi-bell" aria-hidden="true"></i><span class="cong-chuong__so" id="soThongBaoChuaDoc" hidden></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end cong-chuong__hop" aria-labelledby="btnChuongCong">
                            <div class="cong-chuong__dau">
                                <strong>Thông báo</strong>
                                <button type="button" class="cong-chuong__doc-het" id="btnDocTatCaThongBao">Đánh dấu đã đọc</button>
                            </div>
                            <ul class="cong-chuong__ds" id="dsThongBaoCong" aria-live="polite"><li class="cong-chuong__trong">Đang tải…</li></ul>
                            <a class="cong-chuong__xem" href="/tai-khoan/thong-bao">Xem tất cả thông báo</a>
                        </div>
                    </div>
                    <a class="cong-lien-ket" href="/tai-khoan" aria-current="@(duongDan.StartsWith("/tai-khoan") ? "page" : null)">
                        <i class="bi bi-person-circle" aria-hidden="true"></i><span class="nhan-dai">@User.FindFirst(ThuVienClaims.Ten)?.Value</span>
                    </a>
                    <form method="post" asp-antiforgery="true" action="/dang-xuat">
                        <button type="submit" class="cong-lien-ket"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="nhan-dai">Đăng xuất</span></button>
                    </form>
                }
                else
                {
                    <a class="cong-lien-ket" href="/dang-nhap" aria-current="@(duongDan == "/dang-nhap" ? "page" : null)">
                        <i class="bi bi-person-circle" aria-hidden="true"></i><span class="nhan-dai">Đăng nhập</span>
                    </a>
                }
            </div>
        </div>
        <nav class="cong-nav d-none d-lg-block" aria-label="Điều hướng chính">
            <div class="cong-container">
                <ul>
                    @foreach (var m in menu)
                    {
                        var con = m.Href == "/#danh-muc" ? "danh-muc" : m.Href == "/#huong-dan" ? "huong-dan" : null;
                        <li class="cong-nav__muc@(con is null ? "" : " cong-nav__muc--con")">
                            <a href="@m.Href" data-muc="@m.Href" aria-current="@(m.Href == "/" && laTrangChu ? "page" : null)">@m.Ten</a>
                            @if (con is not null)
                            {
                                @* Menu thả xuống (THAM_KHAO_MTA mục 3.2): mở khi rê chuột, focus, Enter/↓ ở nút mũi tên; Esc đóng *@
                                <button type="button" class="cong-nav__mo" aria-expanded="false" aria-controls="dd-@con"
                                        aria-label="@(con == "danh-muc" ? "Mở danh sách thể loại" : "Mở các mục hướng dẫn")"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
                                <div class="cong-nav__con" id="dd-@con">
                                    <ul class="cong-nav__ds" data-ds-the-loai="@(con == "danh-muc" ? "1" : null)">
                                        @if (con == "danh-muc")
                                        {
                                            <li><a href="/kham-pha"><i class="bi bi-grid" aria-hidden="true"></i>Tất cả thể loại</a></li>
                                        }
                                        else
                                        {
                                            foreach (var (ten, href, icon) in huongDan)
                                            {
                                                <li><a href="@href"><i class="bi @icon" aria-hidden="true"></i>@ten</a></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </div>
        </nav>
        <div class="cong-tien-do-cuon" aria-hidden="true"></div>
    </header>

    @* Điện thoại: menu Offcanvas (file 04 mục 2) *@
    <div class="offcanvas offcanvas-start cong-offcanvas" tabindex="-1" id="congMenu" aria-labelledby="congMenuTieuDe">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title" id="congMenuTieuDe">@tt.TenThuVien</h2>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Đóng menu"></button>
        </div>
        <div class="offcanvas-body">
            @if (gioHomNay is not null)
            {
                <p class="cong-offcanvas__gio"><i class="bi bi-clock" aria-hidden="true"></i> Hôm nay mở cửa: <strong>@gioHomNay</strong></p>
            }
            <nav aria-label="Điều hướng chính (điện thoại)">
                <ul>
                    @foreach (var m in menu)
                    {
                        if (m.Href == "/#danh-muc" || m.Href == "/#huong-dan")
                        {
                            var laDanhMuc = m.Href == "/#danh-muc";
                            @* Điện thoại: nhóm thu gọn (details/summary – không cần JavaScript) *@
                            <li>
                                <details class="cong-offcanvas__nhom">
                                    <summary><i class="bi @m.Icon" aria-hidden="true"></i>@m.Ten<i class="bi bi-chevron-down cong-offcanvas__mui" aria-hidden="true"></i></summary>
                                    <ul class="cong-offcanvas__con" data-ds-the-loai="@(laDanhMuc ? "1" : null)">
                                        <li><a href="@m.Href" data-muc="@m.Href" data-bs-dismiss="offcanvas">@(laDanhMuc ? "Tất cả thể loại" : "Mượn sách và đặt chỗ")</a></li>
                                        @if (!laDanhMuc)
                                        {
                                            foreach (var (ten, href, _) in huongDan)
                                            {
                                                <li><a href="@href">@ten</a></li>
                                            }
                                        }
                                    </ul>
                                </details>
                            </li>
                        }
                        else
                        {
                            <li><a href="@m.Href" data-muc="@m.Href" data-bs-dismiss="offcanvas" aria-current="@(m.Href == "/" && laTrangChu ? "page" : null)"><i class="bi @m.Icon" aria-hidden="true"></i>@m.Ten</a></li>
                        }
                    }
                </ul>
            </nav>
        </div>
    </div>

    <main id="noiDung" tabindex="-1">
        @RenderBody()
    </main>

    @* Footer (THAM_KHAO_MTA mục 3.9): 3 cột, hoa văn nét mảnh tự vẽ, liên kết có mũi tên; nút lên đầu trang *@
    <footer class="cong-footer" id="thong-tin" aria-labelledby="chanTrangTieuDe">
        <div class="cong-container cong-footer__tren">
            <div class="cong-footer__cot cong-footer__cot--chinh">
                <span class="cong-logo__dau cong-footer__logo" aria-hidden="true"><i class="bi bi-book-half"></i></span>
                <h2 id="chanTrangTieuDe">@tt.TenThuVien</h2>
                <p class="cong-footer__mo-ta">Hệ thống quản lý mượn trả sách thư viện đại học – tra cứu sách, xem tình trạng còn sách trên kệ, đặt chỗ và nhận sách tại quầy.</p>
                <ul class="cong-footer__lien-he">
                    @if (!string.IsNullOrWhiteSpace(tt.DiaChi)) { <li><i class="bi bi-geo-alt" aria-hidden="true"></i><span>@tt.DiaChi</span></li> }
                    @if (!string.IsNullOrWhiteSpace(tt.DienThoai)) { <li><i class="bi bi-telephone" aria-hidden="true"></i><a href="tel:@tt.DienThoai">@tt.DienThoai</a></li> }
                    @if (!string.IsNullOrWhiteSpace(tt.Email)) { <li><i class="bi bi-envelope" aria-hidden="true"></i><a href="mailto:@tt.Email">@tt.Email</a></li> }
                </ul>
            </div>
            <div class="cong-footer__cot">
                <h3>Liên kết</h3>
                <ul class="cong-footer__lien-ket">
                    <li><a href="/kham-pha">Khám phá sách</a></li>
                    <li><a href="/#ke-sach">Kệ sách nổi bật</a></li>
                    <li><a href="/huong-dan">Hướng dẫn mượn sách</a></li>
                    <li><a href="/kich-hoat">Kích hoạt tài khoản</a></li>
                    <li><a href="/dang-nhap">Đăng nhập bạn đọc</a></li>
                    <li><a href="/quan-tri/dang-nhap">Đăng nhập nhân viên</a></li>
                </ul>
            </div>
            @if (tt.GioMoCua.Count > 0 || !string.IsNullOrWhiteSpace(tt.NoiQuy))
            {
                <div class="cong-footer__cot">
                    @if (tt.GioMoCua.Count > 0)
                    {
                        <h3>Giờ mở cửa</h3>
                        <ul class="cong-footer__gio">
                            @foreach (var (k, v) in tt.GioMoCua) { <li class="@(k == thu ? "hom-nay" : null)"><span>@k</span><span>@v</span></li> }
                        </ul>
                    }
                    @if (!string.IsNullOrWhiteSpace(tt.NoiQuy))
                    {
                        <h3>Nội quy</h3>
                        <p class="mb-0">@tt.NoiQuy</p>
                    }
                </div>
            }
        </div>
        <div class="cong-footer__duoi">
            <div class="cong-container">© @DateTime.Now.Year @tt.TenThuVien. Hệ thống quản lý mượn trả sách thư viện đại học.</div>
        </div>
    </footer>
    <button type="button" class="cong-len-dau" id="btnLenDau" aria-label="Lên đầu trang" hidden><i class="bi bi-arrow-up" aria-hidden="true"></i></button>

    <partial name="_ScriptChung" />
    <script src="/lib/gsap/3.13.0/ScrollTrigger.min.js"></script>
    <script src="/lib/lenis/1.3.27/lenis.min.js"></script>
    <script type="module" src="/js/cong/cuon-muot.js" asp-append-version="true"></script>
    <script type="module" src="/js/cong/header.js" asp-append-version="true"></script>
    @* Không gắn ?v=: coverflow.js import cùng URL này → một phiên bản module duy nhất *@
    <script type="module" src="/js/cong/book-preview.js"></script>
    @if (laBanDoc)
    {
        <script type="module" src="/js/cong/thong-bao.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
