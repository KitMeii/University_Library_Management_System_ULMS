@{
    ViewData["Title"] = "02.03.01 Lập Biên bản vi phạm mượn trả sách";
    ViewData["NhomMenu"] = "Xử lý vi phạm";
}
<section class="qt-giao-dien" id="frmLapBienBan" aria-labelledby="tieuDeGiaoDien">
    <div class="qt-giao-dien__dau">
        <div>
            <h1 id="tieuDeGiaoDien">Lập Biên bản vi phạm mượn trả sách</h1>
            <p class="qt-giao-dien__phu"><span class="qt-ma-tien-trinh">02.03.01</span>Lập biên bản cho trường hợp vi phạm Bộ phận mượn trả chuyển sang; chọn khoản thu, tính tiền; ghi nhận thanh toán; in Biên bản vi phạm (MB05).</p>
        </div>
    </div>

    <partial name="_ThanhBuoc" model='new[] { "Tìm trường hợp vi phạm", "Chọn khoản thu", "In Biên bản vi phạm" }' />

    <div class="qt-the">
        <div class="qt-tim-chung-tu">
            <div>
                <label class="qt-nhan" for="txtSoPhieuMuon">Số Phiếu mượn sách của trường hợp vi phạm<span class="bat-buoc" aria-hidden="true">*</span></label>
                <div class="qt-nhom-tim">
                    <input class="qt-o" id="txtSoPhieuMuon" maxlength="10" autocomplete="off" placeholder="Ví dụ PM26110001" />
                    <button type="button" class="qt-nut qt-nut--chinh" id="btnTimPhieuMuon"><i class="bi bi-search" aria-hidden="true"></i>Tìm</button>
                </div>
            </div>
            <span class="qt-tim-chung-tu__hoac">hoặc</span>
            <div>
                <label class="qt-nhan" for="txtSoBienBan">Số Biên bản vi phạm đã lưu (để sửa, ghi nhận thanh toán)</label>
                <div class="qt-nhom-tim">
                    <input class="qt-o" id="txtSoBienBan" maxlength="10" autocomplete="off" placeholder="Ví dụ BB26110001" />
                    <button type="button" class="qt-nut qt-nut--phu" id="btnTimBienBan"><i class="bi bi-folder2-open" aria-hidden="true"></i>Tìm biên bản</button>
                </div>
            </div>
        </div>
        <div id="khuThongTin" class="mt-3" hidden aria-live="polite"></div>
        <h2 class="qt-tieu-muc mt-3">Trường hợp vi phạm chờ lập biên bản</h2>
        <div class="qt-luoi" id="dgvTruongHop" aria-label="Trường hợp vi phạm chờ lập biên bản"></div>
        <p class="small text-secondary mt-2 mb-0">Do Bộ phận mượn trả sách chuyển sang khi lập Phiếu trả sách (quá hạn, mất, hư hỏng). Nhấp đúp vào dòng để mở.</p>
    </div>

    <div class="qt-the">
        <h2 class="qt-tieu-muc">Thông tin biên bản</h2>
        <div class="qt-khu-nhap">
            <div class="qt-truong"><label class="qt-nhan" for="txtThoiGianLap">Thời gian lập</label><input class="qt-o" id="txtThoiGianLap" readonly placeholder="Cấp khi in" /></div>
            <div class="qt-truong"><label class="qt-nhan" for="txtMaBanDoc">Mã bạn đọc</label><input class="qt-o" id="txtMaBanDoc" readonly /></div>
            <div class="qt-truong qt-truong--rong"><label class="qt-nhan" for="txtHoTen">Họ và tên</label><input class="qt-o" id="txtHoTen" readonly /></div>
            <div class="qt-truong"><label class="qt-nhan" for="txtLopDonVi">Lớp/Đơn vị</label><input class="qt-o" id="txtLopDonVi" readonly /></div>
            <div class="qt-truong"><label class="qt-nhan" for="txtNguoiLap">Người lập</label><input class="qt-o" id="txtNguoiLap" readonly value="@User.TenNd()" /></div>
        </div>

        <h2 class="qt-tieu-muc mt-2">Bản sách vi phạm</h2>
        <div class="qt-luoi" id="dgvSachViPham" aria-label="Bản sách vi phạm"></div>

        <h2 class="qt-tieu-muc mt-3">Khoản thu</h2>
        <div class="qt-khu-nhap">
            <div class="qt-truong qt-truong--rong">
                <label class="qt-nhan" for="cboKhoanThu">Khoản thu<span class="bat-buoc" aria-hidden="true">*</span></label>
                <select class="qt-o" id="cboKhoanThu"></select>
            </div>
            <div class="qt-truong">
                <label class="qt-nhan" for="cboBanSach">Bản sách<span class="bat-buoc" aria-hidden="true">*</span></label>
                <select class="qt-o" id="cboBanSach"></select>
            </div>
            <div class="qt-truong">
                <label class="qt-nhan" for="txtSoLuong">Số lượng<span class="bat-buoc" aria-hidden="true">*</span></label>
                <input class="qt-o so-lieu" id="txtSoLuong" type="number" min="1" max="99999" step="1" value="1" inputmode="numeric" />
            </div>
            <div class="qt-truong">
                <span class="qt-nhan" id="nhanDonGia">Đơn giá</span>
                <output class="qt-o so-lieu" id="lblDonGia" aria-labelledby="nhanDonGia">–</output>
            </div>
            <div class="qt-truong d-flex align-items-end">
                <button type="button" class="qt-nut qt-nut--phu w-100" id="btnThemCT"><i class="bi bi-plus-lg" aria-hidden="true"></i>Thêm khoản thu</button>
            </div>
        </div>
        <div class="qt-luoi" id="dgvChiTiet" aria-label="Chi tiết Biên bản vi phạm"></div>
        <p class="small text-secondary mt-2 mb-0">Nhấp đúp vào dòng để sửa số lượng hoặc bỏ dòng chưa lưu.</p>
        <div class="qt-khu-nhap mt-3">
            <div class="qt-truong">
                <label class="qt-nhan" for="cboHTThanhToan">Hình thức thanh toán<span class="bat-buoc" aria-hidden="true">*</span></label>
                <select class="qt-o" id="cboHTThanhToan">
                    <option value="Chưa thanh toán">Chưa thanh toán</option>
                    <option value="Tiền mặt">Tiền mặt</option>
                    <option value="Chuyển khoản">Chuyển khoản</option>
                </select>
            </div>
        </div>
        <div class="qt-tong">
            <span>Tổng tiền: <strong id="lblTongTien" class="qt-tong__tien so-lieu">0 đ</strong></span>
        </div>
        <p class="qt-in-gan-nhat" id="khuInGanNhat" hidden>Chứng từ vừa in: <a target="_blank" rel="noopener"></a></p>

        <div class="qt-hang-nut" role="group" aria-label="Nút lệnh">
            <button type="button" class="qt-nut qt-nut--chinh" id="btnIn"><i class="bi bi-printer" aria-hidden="true"></i>In</button>
            <button type="button" class="qt-nut qt-nut--phu" id="btnHuy"><i class="bi bi-x-lg" aria-hidden="true"></i>Hủy</button>
            <button type="button" class="qt-nut qt-nut--phu qt-hang-nut__phai" id="btnDong"><i class="bi bi-box-arrow-left" aria-hidden="true"></i>Đóng</button>
        </div>
    </div>
</section>
@section Scripts {
    <script type="module" src="/js/quantri/trang/bien-ban.js" asp-append-version="true"></script>
}
