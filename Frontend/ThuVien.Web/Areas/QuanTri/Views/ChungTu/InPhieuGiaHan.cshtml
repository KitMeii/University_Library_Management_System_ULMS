@model ThuVien.Web.Areas.QuanTri.Models.KhungIn
@using ThuVien.Web.Areas.QuanTri.Models
@{
    Layout = "_LayoutIn";
    var d = (PhieuGiaHanIn)Model.DuLieu;
    DauIn Dau(int lien) => new(Model, lien, "Bộ phận mượn trả sách", $"Ngày lập: {d.NgayLapPGiaHan:dd/MM/yyyy}");
}
@* SPEC 6.4.2 – MB03 Phiếu gia hạn sách: A5, 02 bản *@
@for (var i = 0; i < Model.Lien.Length; i++)
{
    <article class="in-to">
        <partial name="_DauIn" model="Dau(i)" />
        <dl class="in-thong-tin">
            <div><dt>Số phiếu mượn</dt><dd>@d.SoPMuon</dd></div>
            <div><dt>Ngày đề nghị</dt><dd>@d.NgayDeNghi.ToString("dd/MM/yyyy")</dd></div>
            <div><dt>Mã bạn đọc</dt><dd>@d.BanDoc.MaBanDoc</dd></div>
            <div><dt>Họ và tên</dt><dd><strong>@d.BanDoc.HoTen</strong></dd></div>
            <div><dt>Mã SV/HV/CB</dt><dd>@d.BanDoc.MaSvHvCb</dd></div>
        </dl>
        <table class="in-bang">
            <thead>
                <tr><th>STT</th><th>Mã bản sách</th><th>Tên sách</th><th>Hạn trả cũ</th><th>Kết quả</th><th>Hạn trả mới</th><th>Số lần gia hạn</th><th>Lý do không gia hạn</th></tr>
            </thead>
            <tbody>
                @for (var j = 0; j < d.ChiTiet.Count; j++)
                {
                    var x = d.ChiTiet[j];
                    <tr>
                        <td class="giua">@(j + 1)</td><td>@x.MaBanSach</td><td>@x.TenSach</td>
                        <td class="giua">@x.HanTraCu.ToString("dd/MM/yyyy")</td><td>@x.KetQuaGiaHan</td>
                        <td class="giua"><strong>@x.HanTraMoi?.ToString("dd/MM/yyyy")</strong></td><td class="giua">@x.SoLanGiaHan</td><td>@x.LyDoKhongGh</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="8">Đồng ý gia hạn: <strong>@d.ChiTiet.Count(x => x.KetQuaGiaHan == "Đồng ý")</strong> / @d.ChiTiet.Count bản</td></tr>
            </tfoot>
        </table>
        <p class="in-ghi-chu">Hạn trả mới = hạn trả cũ + @d.SoNgayGiaHan ngày. Số lần gia hạn = số lần gia hạn được đồng ý của bản sách.</p>
        <div class="in-ky">
            <div><span>Bạn đọc</span><em>(Ký, ghi rõ họ tên)</em><b>@d.BanDoc.HoTen</b></div>
            <div><span>Người lập phiếu</span><em>(Ký, ghi rõ họ tên)</em><b>@d.TenNd</b></div>
        </div>
    </article>
}
