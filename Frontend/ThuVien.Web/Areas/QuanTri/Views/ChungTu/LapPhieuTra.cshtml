@{
    ViewData["Title"] = "01.02.02 Lập Phiếu trả sách";
    ViewData["NhomMenu"] = "Mượn trả sách";
}
<section class="qt-giao-dien" id="frmLapPhieuTra" aria-labelledby="tieuDeGiaoDien">
    <div class="qt-giao-dien__dau">
        <div>
            <h1 id="tieuDeGiaoDien">Lập Phiếu trả sách</h1>
            <p class="qt-giao-dien__phu"><span class="qt-ma-tien-trinh">01.02.02</span>Lập Phiếu trả sách cho một Phiếu mượn sách (trả nhiều lần thì bổ sung); tính số ngày quá hạn, xác định vi phạm; in Phiếu trả sách (MB04).</p>
        </div>
    </div>

    <partial name="_ThanhBuoc" model='new[] { "Tìm Phiếu mượn sách", "Chọn bản sách trả", "In Phiếu trả sách" }' />

    <div class="qt-the">
        <div class="qt-tim-chung-tu">
            <div>
                <label class="qt-nhan" for="txtSoPhieuMuon">Số Phiếu mượn sách<span class="bat-buoc" aria-hidden="true">*</span></label>
                <div class="qt-nhom-tim">
                    <input class="qt-o" id="txtSoPhieuMuon" maxlength="10" autocomplete="off" placeholder="Ví dụ PM26110001" />
                    <button type="button" class="qt-nut qt-nut--chinh" id="btnTimPhieuMuon"><i class="bi bi-search" aria-hidden="true"></i>Tìm Phiếu mượn</button>
                </div>
            </div>
            <span class="qt-tim-chung-tu__hoac">hoặc</span>
            <div>
                <label class="qt-nhan" for="txtSoPhieu">Số Phiếu trả đã lưu (để sửa)</label>
                <div class="qt-nhom-tim">
                    <input class="qt-o" id="txtSoPhieu" maxlength="10" autocomplete="off" placeholder="Ví dụ PT26110001" />
                    <button type="button" class="qt-nut qt-nut--phu" id="btnTimPhieu"><i class="bi bi-folder2-open" aria-hidden="true"></i>Tìm phiếu</button>
                </div>
            </div>
        </div>
        <div id="khuThongTin" class="mt-3" hidden aria-live="polite"></div>
    </div>

    <div class="qt-the">
        <h2 class="qt-tieu-muc">Thông tin phiếu</h2>
        <div class="qt-khu-nhap">
            <div class="qt-truong"><label class="qt-nhan" for="txtSoPTra">Số phiếu trả</label><input class="qt-o" id="txtSoPTra" readonly placeholder="Cấp khi in" /></div>
            <div class="qt-truong"><label class="qt-nhan" for="txtNgayLap">Ngày lập</label><input class="qt-o" id="txtNgayLap" readonly placeholder="Cấp khi in" /></div>
            <div class="qt-truong"><label class="qt-nhan" for="txtMaBanDoc">Mã bạn đọc</label><input class="qt-o" id="txtMaBanDoc" readonly /></div>
            <div class="qt-truong qt-truong--rong"><label class="qt-nhan" for="txtHoTen">Họ và tên</label><input class="qt-o" id="txtHoTen" readonly /></div>
            <div class="qt-truong"><label class="qt-nhan" for="txtMaSvHvCb">Mã SV/HV/CB</label><input class="qt-o" id="txtMaSvHvCb" readonly /></div>
            <div class="qt-truong">
                <label class="qt-nhan" for="dtpNgayTra">Ngày trả<span class="bat-buoc" aria-hidden="true">*</span></label>
                <input class="qt-o" id="dtpNgayTra" type="date" />
            </div>
            <div class="qt-truong"><label class="qt-nhan" for="txtNguoiLap">Người lập</label><input class="qt-o" id="txtNguoiLap" readonly value="@User.TenNd()" /></div>
        </div>

        <h2 class="qt-tieu-muc mt-2">Bản sách của Phiếu mượn sách</h2>
        <div class="qt-luoi" id="dgvChiTiet" aria-label="Chi tiết Phiếu trả sách"></div>
        <p class="small text-secondary mt-2 mb-0">Đánh dấu bản sách Bạn đọc trả, chọn tình trạng khi trả. Quá hạn, mất, hư hỏng được chuyển Bộ phận xử lý vi phạm khi in phiếu.</p>
        <div class="qt-tong">
            <span>Trả lần này: <strong id="lblSoTra" class="so-lieu">0</strong></span>
            <span>Trường hợp vi phạm: <strong id="lblViPham" class="so-lieu">0</strong></span>
        </div>
        <p class="qt-in-gan-nhat" id="khuInGanNhat" hidden>Chứng từ vừa in: <a target="_blank" rel="noopener"></a></p>

        <div class="qt-hang-nut" role="group" aria-label="Nút lệnh">
            <button type="button" class="qt-nut qt-nut--chinh" id="btnIn"><i class="bi bi-printer" aria-hidden="true"></i>In</button>
            <button type="button" class="qt-nut qt-nut--phu" id="btnHuy"><i class="bi bi-x-lg" aria-hidden="true"></i>Hủy</button>
            <button type="button" class="qt-nut qt-nut--phu qt-hang-nut__phai" id="btnDong"><i class="bi bi-box-arrow-left" aria-hidden="true"></i>Đóng</button>
        </div>
    </div>
</section>
@section Scripts {
    <script type="module" src="/js/quantri/trang/phieu-tra.js" asp-append-version="true"></script>
}
