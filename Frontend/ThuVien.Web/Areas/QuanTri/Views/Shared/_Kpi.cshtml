@model ThuVien.Web.Areas.QuanTri.Models.KpiVm
@* Thẻ KPI (file 08 mục 4): số đếm lên, thanh tiến độ mảnh; bấm được → trang/danh sách chi tiết. *@
@{
    var noiDung = Html.Raw($"""
        <span class="qt-kpi__dau"><span class="qt-kpi__nhan">{System.Net.WebUtility.HtmlEncode(Model.Nhan)}</span><i class="bi {Model.Icon} qt-kpi__icon" aria-hidden="true"></i></span>
        <strong class="qt-kpi__so so-lieu" id="{Model.Id}">–</strong>
        <span class="qt-kpi__phu" id="{Model.Id}Phu">{System.Net.WebUtility.HtmlEncode(Model.MoTa ?? "")}</span>
        <span class="qt-kpi__thanh" aria-hidden="true"><span></span></span>
        """);
}
@if (Model.Href is not null)
{
    <a class="qt-the qt-kpi qt-kpi--bam" href="@Model.Href">@noiDung<span class="sr-only"> – xem chi tiết</span></a>
}
else if (Model.ChiTiet is not null)
{
    <button type="button" class="qt-the qt-kpi qt-kpi--bam" data-chi-tiet="@Model.ChiTiet">@noiDung<span class="sr-only"> – xem danh sách chi tiết</span></button>
}
else
{
    <div class="qt-the qt-kpi">@noiDung</div>
}
