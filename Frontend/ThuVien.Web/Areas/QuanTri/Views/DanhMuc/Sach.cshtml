@model ThuVien.Web.Areas.QuanTri.Controllers.DanhMucSachVm
@{
    ViewData["Title"] = "Danh mục sách";
    ViewData["NhomMenu"] = User.HasClaim(ThuVienClaims.MaNhom, "N3") ? "Kho sách" : "Danh mục";
    var tinhTrang = new[] { "Sẵn sàng", "Đang được mượn", "Mất", "Hư hỏng" };
}
<section class="qt-giao-dien" id="frmDanhMucSach" data-tien-trinh="@Model.TienTrinh" aria-labelledby="tieuDeGiaoDien">
    <div class="qt-giao-dien__dau">
        <div>
            <h1 id="tieuDeGiaoDien">Danh mục sách</h1>
            <p class="qt-giao-dien__phu">
                Danh sách bản sách của thư viện.
                @if (Model.CapNhatTinhTrang) { <text>Bộ phận kho sách thực hiện 03.01.02, 03.01.04, 03.02.03, 03.03.02, 03.04.01 tại đây.</text> }
                @if (Model.Quyen.ChiXem) { <text>Bạn chỉ có quyền xem.</text> }
            </p>
        </div>
    </div>

    <div class="qt-the">
        <form id="frmChiTiet" class="qt-khu-nhap" novalidate>
            <div class="qt-truong">
                <label class="qt-nhan" for="txtMaBanSach">Mã bản sách<span class="bat-buoc" aria-hidden="true">*</span></label>
                <input class="qt-o" id="txtMaBanSach" maxlength="10" readonly autocomplete="off" />
            </div>
            <div class="qt-truong qt-truong--rong">
                <label class="qt-nhan" for="txtTenSach">Tên sách<span class="bat-buoc" aria-hidden="true">*</span></label>
                <input class="qt-o" id="txtTenSach" maxlength="200" readonly autocomplete="off" />
            </div>
            <div class="qt-truong">
                <label class="qt-nhan" for="txtTacGia">Tác giả<span class="bat-buoc" aria-hidden="true">*</span></label>
                <input class="qt-o" id="txtTacGia" maxlength="100" readonly autocomplete="off" />
            </div>
            <div class="qt-truong">
                <label class="qt-nhan" for="cboKhuVuc">Khu vực lưu trữ<span class="bat-buoc" aria-hidden="true">*</span></label>
                <select class="qt-o" id="cboKhuVuc" disabled></select>
            </div>
            <div class="qt-truong">
                <label class="qt-nhan" for="cboTinhTrang">Tình trạng<span class="bat-buoc" aria-hidden="true">*</span></label>
                <select class="qt-o" id="cboTinhTrang" disabled>
                    @foreach (var t in tinhTrang) { <option value="@t">@t</option> }
                </select>
            </div>
        </form>

        <div class="qt-thanh-tim">
            <label class="sr-only" for="txtTimKiem">Từ khóa tìm kiếm</label>
            <input class="qt-o" id="txtTimKiem" type="search" placeholder="Tìm theo mã, tên sách, tác giả, tình trạng, khu vực" autocomplete="off" />
            <button type="button" class="qt-nut qt-nut--phu" id="btnTimKiem"><i class="bi bi-search" aria-hidden="true"></i>Tìm kiếm</button>
            <div class="qt-thanh-tim__phai">
                <label class="qt-nhan mb-0" for="cboLocTinhTrang">Lọc theo tình trạng</label>
                <select class="qt-o" id="cboLocTinhTrang">
                    <option value="">Tất cả tình trạng</option>
                    @foreach (var t in tinhTrang) { <option value="@t">@t</option> }
                </select>
            </div>
        </div>
        <p class="small text-secondary mt-2 mb-0" id="ghiChuTimKiem" hidden>
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            Kết quả tìm kiếm đã loại các bản sách đang thuộc phiếu mượn chưa trả (03.01.02 Kiểm tra khả năng đáp ứng sách).
        </p>
        <div class="qt-thong-ke-nho mt-3" id="thongKeTinhTrang" aria-label="Số sách theo tình trạng (03.04.01)" aria-live="polite"></div>

        <div class="qt-luoi mt-3" id="dgvSach" aria-label="Danh sách bản sách"></div>

        <partial name="_HangNutDanhMuc" model="Model.Quyen" />
    </div>

    @if (Model.CapNhatTinhTrang)
    {
        <div class="qt-the" id="khuChuyenDen">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h2 class="qt-the__tieu-de mb-0">Thông tin bộ phận khác chuyển đến</h2>
                <span class="small text-secondary">Sách đã cho mượn (03.01.04) · Sách trả (03.02.03) · Sách bị mất, hư hỏng (03.03.02)</span>
            </div>
            <div class="qt-luoi" id="dgvChuyenDen" aria-label="Danh sách sách chuyển đến"></div>
            <div class="qt-hang-nut">
                <button type="button" class="qt-nut qt-nut--chinh" id="btnCapNhatTT" disabled><i class="bi bi-arrow-repeat" aria-hidden="true"></i>Cập nhật tình trạng</button>
            </div>
        </div>
    }
</section>
@section Scripts {
    <script type="module" src="/js/quantri/trang/sach.js" asp-append-version="true"></script>
}
