@model BaoCaoVm
@{
    var muonTra = Model.Loai == "muon-tra";
    var ma = muonTra ? "01.04.02" : "02.05.01";
    var ten = muonTra ? "Tổng hợp tình hình mượn trả sách" : "Tổng hợp tình hình vi phạm mượn trả sách";
    ViewData["Title"] = $"{ma} {ten}";
    ViewData["NhomMenu"] = "Thống kê";
}
@section Css {
    <link rel="stylesheet" href="/css/thong-ke.css" asp-append-version="true" />
}
<section class="qt-giao-dien" id="@(muonTra ? "frmTongHopMuonTra" : "frmTongHopViPham")" data-loai="@Model.Loai" aria-labelledby="tieuDeGiaoDien">
    <div class="qt-giao-dien__dau">
        <div>
            <h1 id="tieuDeGiaoDien">@ten</h1>
            <p class="qt-giao-dien__phu"><span class="qt-ma-tien-trinh">@ma</span>@(muonTra
                ? "Tổng hợp số lượt mượn, gia hạn, trả sách trong kỳ; thống kê sách đang mượn, quá hạn; liệt kê chi tiết (MB06)."
                : "Tổng hợp số trường hợp vi phạm theo khoản thu, số tiền thu được; liệt kê Bạn đọc vi phạm và tình trạng thanh toán (MB07).")</p>
        </div>
    </div>

    <div class="qt-the">
        <h2 class="qt-tieu-muc">Kỳ báo cáo</h2>
        <div class="qt-ky-bao-cao">
            <div class="qt-truong">
                <label class="qt-nhan" for="dtpTuNgay">Từ ngày<span class="bat-buoc" aria-hidden="true">*</span></label>
                <input class="qt-o" id="dtpTuNgay" type="date" />
            </div>
            <div class="qt-truong">
                <label class="qt-nhan" for="dtpDenNgay">Đến ngày<span class="bat-buoc" aria-hidden="true">*</span></label>
                <input class="qt-o" id="dtpDenNgay" type="date" />
            </div>
            <div class="qt-ky-bao-cao__nhanh" role="group" aria-label="Chọn nhanh kỳ báo cáo">
                <button type="button" class="qt-nut qt-nut--phu qt-nut--nho" data-ky="hom-nay" aria-pressed="false">Hôm nay</button>
                <button type="button" class="qt-nut qt-nut--phu qt-nut--nho" data-ky="7-ngay" aria-pressed="false">7 ngày</button>
                <button type="button" class="qt-nut qt-nut--phu qt-nut--nho" data-ky="thang-nay" aria-pressed="false">Tháng này</button>
                <button type="button" class="qt-nut qt-nut--phu qt-nut--nho" data-ky="thang-truoc" aria-pressed="false">Tháng trước</button>
            </div>
            <button type="button" class="qt-nut qt-nut--chinh" id="btnTongHop"><i class="bi bi-calculator" aria-hidden="true"></i>Tổng hợp</button>
        </div>
    </div>

    <div class="qt-ket-qua-tong-hop" id="khuKetQua" hidden aria-live="polite">
        @if (muonTra)
        {
            <div class="qt-luoi-kpi">
                <partial name="_Kpi" model='new KpiVm("lblTongLuotMuon", "Tổng số lượt mượn", "bi-journal-arrow-up", MoTa: "COUNT(CT_PHIEUMUON) trong kỳ")' />
                <partial name="_Kpi" model='new KpiVm("lblTongLuotGiaHan", "Tổng số lượt gia hạn", "bi-calendar-plus", MoTa: "Kết quả “Đồng ý” trong kỳ")' />
                <partial name="_Kpi" model='new KpiVm("lblTongLuotTra", "Tổng số lượt trả", "bi-journal-arrow-down", MoTa: "COUNT(CT_PHIEUTRA) trong kỳ")' />
                <partial name="_Kpi" model='new KpiVm("lblSoSachDangMuon", "Số sách đang mượn", "bi-book", MoTa: "Tính đến ngày cuối kỳ")' />
                <partial name="_Kpi" model='new KpiVm("lblSoSachQuaHan", "Số sách quá hạn", "bi-alarm", MoTa: "Chưa trả, hạn trả trước ngày cuối kỳ")' />
            </div>
            <div class="qt-luoi-bieu-do mt-3">
                <partial name="_BieuDo" model='new BieuDoVm("bdTheoNgay", "Lượt mượn, gia hạn, trả theo ngày", Lop: "qt-bieu-do--rong", TenTep: "MB06_theo_ngay")' />
            </div>
            <div class="qt-the mt-3">
                <ul class="nav qt-the-tab" role="tablist" aria-label="Chi tiết tình hình mượn trả sách">
                    <li role="presentation"><button type="button" class="qt-the-tab__muc" role="tab" id="tabLuotMuon" aria-controls="khuLuotMuon" aria-selected="true">Lượt mượn <span class="so-lieu" data-dem="luotMuon"></span></button></li>
                    <li role="presentation"><button type="button" class="qt-the-tab__muc" role="tab" id="tabLuotGiaHan" aria-controls="khuLuotGiaHan" aria-selected="false" tabindex="-1">Lượt gia hạn <span class="so-lieu" data-dem="luotGiaHan"></span></button></li>
                    <li role="presentation"><button type="button" class="qt-the-tab__muc" role="tab" id="tabLuotTra" aria-controls="khuLuotTra" aria-selected="false" tabindex="-1">Lượt trả <span class="so-lieu" data-dem="luotTra"></span></button></li>
                    <li role="presentation"><button type="button" class="qt-the-tab__muc" role="tab" id="tabSachQuaHan" aria-controls="khuSachQuaHan" aria-selected="false" tabindex="-1">Sách quá hạn <span class="so-lieu" data-dem="sachQuaHan"></span></button></li>
                </ul>
                <div role="tabpanel" id="khuLuotMuon" aria-labelledby="tabLuotMuon" class="mt-3"><div class="qt-luoi" id="dgvLuotMuon" aria-label="Lượt mượn trong kỳ"></div></div>
                <div role="tabpanel" id="khuLuotGiaHan" aria-labelledby="tabLuotGiaHan" class="mt-3" hidden><div class="qt-luoi" id="dgvLuotGiaHan" aria-label="Lượt gia hạn trong kỳ"></div></div>
                <div role="tabpanel" id="khuLuotTra" aria-labelledby="tabLuotTra" class="mt-3" hidden><div class="qt-luoi" id="dgvLuotTra" aria-label="Lượt trả trong kỳ"></div></div>
                <div role="tabpanel" id="khuSachQuaHan" aria-labelledby="tabSachQuaHan" class="mt-3" hidden><div class="qt-luoi" id="dgvSachQuaHan" aria-label="Sách quá hạn tính đến ngày cuối kỳ"></div></div>
            </div>
        }
        else
        {
            <div class="qt-luoi-kpi">
                <partial name="_Kpi" model='new KpiVm("lblSoBienBan", "Số biên bản", "bi-file-earmark-ruled", MoTa: "Lập trong kỳ")' />
                <partial name="_Kpi" model='new KpiVm("lblSoTruongHop", "Số trường hợp vi phạm", "bi-exclamation-octagon", MoTa: "COUNT(CT_BIENBAN) theo khoản thu")' />
                <partial name="_Kpi" model='new KpiVm("lblTongTienViPham", "Tổng tiền vi phạm", "bi-receipt", MoTa: "SUM(thanh_tien)")' />
                <partial name="_Kpi" model='new KpiVm("lblTongTienDaThu", "Tổng tiền thu trong kỳ", "bi-cash-coin", MoTa: "Biên bản đã thanh toán")' />
                <partial name="_Kpi" model='new KpiVm("lblTongTienChuaThu", "Chưa thanh toán", "bi-hourglass-split", MoTa: "Biên bản chưa thanh toán")' />
            </div>
            <div class="qt-luoi-bieu-do mt-3">
                <partial name="_BieuDo" model='new BieuDoVm("bdTheoKhoanThu", "Số trường hợp vi phạm theo khoản thu", "Chồng theo tình trạng thanh toán", TenTep: "MB07_theo_khoan_thu")' />
                <partial name="_BieuDo" model='new BieuDoVm("bdTyLeKhoanThu", "Tỷ lệ trường hợp vi phạm theo khoản thu", TenTep: "MB07_ty_le")' />
            </div>
            <div class="qt-the mt-3">
                <ul class="nav qt-the-tab" role="tablist" aria-label="Chi tiết tình hình vi phạm">
                    <li role="presentation"><button type="button" class="qt-the-tab__muc" role="tab" id="tabTheoKhoanThu" aria-controls="khuTheoKhoanThu" aria-selected="true">Theo khoản thu</button></li>
                    <li role="presentation"><button type="button" class="qt-the-tab__muc" role="tab" id="tabBienBan" aria-controls="khuBienBan" aria-selected="false" tabindex="-1">Bạn đọc vi phạm <span class="so-lieu" data-dem="bienBan"></span></button></li>
                </ul>
                <div role="tabpanel" id="khuTheoKhoanThu" aria-labelledby="tabTheoKhoanThu" class="mt-3"><div class="qt-luoi" id="dgvTheoKhoanThu" aria-label="Tổng hợp theo khoản thu"></div></div>
                <div role="tabpanel" id="khuBienBan" aria-labelledby="tabBienBan" class="mt-3" hidden><div class="qt-luoi" id="dgvBienBan" aria-label="Bạn đọc vi phạm và tình trạng thanh toán"></div></div>
            </div>
        }
    </div>

    <div class="qt-the qt-the--chi-nut">
        <div class="qt-hang-nut" role="group" aria-label="Nút lệnh">
            <button type="button" class="qt-nut qt-nut--chinh" id="btnLapBaoCao" disabled><i class="bi bi-file-earmark-text" aria-hidden="true"></i>Lập báo cáo (@(muonTra ? "01.04.03" : "02.05.02"))</button>
            <button type="button" class="qt-nut qt-nut--phu qt-hang-nut__phai" id="btnDong"><i class="bi bi-box-arrow-left" aria-hidden="true"></i>Đóng</button>
        </div>
    </div>
</section>
@section Scripts {
    <script src="/lib/echarts/5.6.0/echarts.min.js"></script>
    <script type="module" src="/js/quantri/trang/bao-cao.js" asp-append-version="true"></script>
}
