# Chép thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit .env. Mật khẩu SQL phải đủ mạnh (≥ 8 ký tự, có chữ hoa, chữ thường, số, ký hiệu);
# không dùng các ký tự ; " ' $ \ trong mật khẩu (dùng trong chuỗi kết nối).

# Môi trường: Production (docker-compose.override.yml tự đặt Development khi chạy dev)
ASPNETCORE_ENVIRONMENT=Production

# ---- CSDL (GIA_DINH D44) ----
# Cách 1 – SQL Server trong Docker (mặc định): COMPOSE_PROFILES=sql-docker, DB_SERVER=sqlserver
# Cách 2 – SQL Server cài sẵn trên máy (mở bằng SSMS): COMPOSE_PROFILES= (trống), DB_SERVER=host.docker.internal,1433
#          (bật TCP/IP 1433 và SQL Server Authentication trong SQL Server Configuration Manager)
COMPOSE_PROFILES=sql-docker
DB_SERVER=sqlserver
# Mật khẩu sa của SQL Server đang dùng (Cách 1: tự đặt khi tạo container; Cách 2: mật khẩu sa sẵn có)
MSSQL_SA_PASSWORD=
MSSQL_PID=Developer

# Login SQL riêng của từng service (chỉ ghi schema của mình – GIA_DINH D10, D14)
SVC_QUANTRI_PASSWORD=
SVC_KHOSACH_PASSWORD=
SVC_MUONTRA_PASSWORD=
SVC_VIPHAM_PASSWORD=

# Khóa ký JWT dùng chung (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET_KEY=

# Mật khẩu tài khoản quản trị "admin" khởi tạo (≥ 8 ký tự, có chữ và số; Production bắt đổi ở lần đăng nhập đầu)
ADMIN_PASSWORD=

# Số vòng lặp PBKDF2 (GIA_DINH D5)
MATKHAU_SO_VONG_LAP=600000

# Cổng web trên máy chủ
WEB_PORT=8080

# Hiện nhãn "DỮ LIỆU MẪU" ở Development (đặt false khi chụp bộ ảnh Bài 4 – GIA_DINH D23)
HIEN_NHAN_DU_LIEU_MAU=true

# Cổng SQL Server container mở ra máy để dùng SSMS (Cách 1, dev). Mặc định 1434 (GIA_DINH D10)
SQL_PORT=1434
# Thư mục sao lưu (04.00.09). Trống = thư mục mặc định của SQL Server; Cách 1 dùng /var/opt/mssql/backup
SAO_LUU_THU_MUC=/var/opt/mssql/backup
